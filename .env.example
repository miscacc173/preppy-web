APP_NAME="Preppy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ai_exam_prep
DB_USERNAME=edtech
DB_PASSWORD=techedupass9090
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
MAIL_MAILER=log
FILESYSTEM_DISK=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Sign in with Apple (authentication; separate from Apple In-App Purchase)
APPLE_SIGN_IN_ENABLED=false
# Apple Services ID used for browser/web Sign in with Apple.
APPLE_SIGN_IN_CLIENT_ID=
# Native iOS audience / Bundle ID. Defaults to APPLE_IAP_BUNDLE_ID when omitted.
APPLE_SIGN_IN_NATIVE_CLIENT_ID=com.preppy.preppy
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY_PATH=
# Optional alternative to PRIVATE_KEY_PATH; escaped newlines (\n) are supported.
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_SIGN_IN_REDIRECT_URI=http://localhost:8000/auth/apple/callback
VITE_APP_NAME="${APP_NAME}"

# Development only. Ignored automatically in staging and production.
PAYMENT_DEV_BYPASS=false

# Signup and guest-demo email verification. The bypass is development-only and ignored in staging/production.
EMAIL_VERIFICATION_DEV_BYPASS=false
EMAIL_VERIFICATION_MODE=random
EMAIL_VERIFICATION_STATIC_CODE=
EMAIL_VERIFICATION_EXPIRES_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_GRANT_EXPIRES_MINUTES=10

# for mock payments screens...
MOCK_PAYMENTS_ENABLED=false

# Refer-a-friend reward promo
REFERRAL_REWARD_TYPE=percentage
REFERRAL_REWARD_PERCENTAGE=10
REFERRAL_REWARD_AMOUNT_MINOR=0
REFERRAL_REWARD_VALID_DAYS=30

# Apple In-App Purchase / App Store Server API
APPLE_IAP_ENABLED=false
APPLE_IAP_ENVIRONMENT=auto
APPLE_IAP_BUNDLE_ID=com.preppy.preppy
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=

# Firebase Cloud Messaging (FCM)
# Web push requires the Firebase web-app values + a Web Push certificate (VAPID key).
# Server delivery requires a Firebase service account with Firebase Cloud Messaging API access.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternative to a path: one-line JSON or individual client email/private key values.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
